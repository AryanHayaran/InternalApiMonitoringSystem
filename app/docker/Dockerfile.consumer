FROM python:3.12-slim

# Set working directory
WORKDIR /app

# Install system dependencies for Kafka client
RUN apt-get update && \
    apt-get install -y gcc librdkafka-dev && \
    rm -rf /var/lib/apt/lists/*

# Copy and install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all project files into container
COPY . .

# Add app directory to PYTHONPATH so imports like `from app.core.config import Config` work
ENV PYTHONPATH=/app

# Start the Kafka consumer as a module (ensures correct import path)
CMD ["python", "-m", "app.infrastructure.kafka.consumer"]
