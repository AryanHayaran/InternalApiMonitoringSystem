# =============================================================================
# Internal API Monitoring System — environment template
#
# Copy to .env and fill in real values:   cp .env.example .env
# .env is gitignored. Never commit real credentials.
#
# Values shown are safe local-development defaults unless marked REQUIRED.
# =============================================================================


# -----------------------------------------------------------------------------
# PostgreSQL  (REQUIRED — all five, or the app cannot build a connection)
# -----------------------------------------------------------------------------
# Inside Docker, compose overrides PGHOST to the service name `postgres`.
# These three are also read by docker-compose.yml to provision the container.
PGHOST=localhost
PGPORT=5432
PGDATABASE=api_monitoring
PGUSER=postgres
PGPASSWORD=change_me


# -----------------------------------------------------------------------------
# Redis  (optional — the app runs fine without it, just without these features)
# -----------------------------------------------------------------------------
# Used for the JWT revocation list and login rate limiting. Every call fails
# open: if Redis is down, logins are allowed and revocation checks pass.
# Inside Docker, compose overrides REDIS_HOST to `redis`.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USER=
REDIS_PASSWORD=


# -----------------------------------------------------------------------------
# Kafka
# -----------------------------------------------------------------------------
# NOTE: the clients read KAFKA_BROKER_URL. `KAFKA_BROKER` exists in config.py
# but nothing uses it — setting it alone will not work.
# Inside Docker this becomes kafka:29092; from the host it is localhost:9092.
KAFKA_BROKER_URL=localhost:9092
KAFKA_TOPIC_NAME=api-monitoring-results

# Consumer groups — two independent readers of the same topic
KAFKA_CONSUMER_GROUP=monitoring_consumer_group
KAFKA_ROLLUP_GROUP=metrics-rollup-group

# Keep this as `latest`. With `earliest`, a consumer starting fresh replays the
# entire retained backlog against current windows and manufactures bogus
# historical incidents.
KAFKA_AUTO_OFFSET_RESET=latest

# Producer tuning (defaults are sensible; override only if you know why)
KAFKA_ACKS=all
KAFKA_ENABLE_IDEMPOTENCE=true
KAFKA_COMPRESSION_TYPE=gzip
KAFKA_MAX_RETRIES=5
KAFKA_RETRY_DELAY_S=2
KAFKA_REQUEST_TIMEOUT_MS=30000

# Only needed for a SASL-secured broker; leave blank for local PLAINTEXT
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_USERNAME=
KAFKA_PASSWORD=


# -----------------------------------------------------------------------------
# JWT  (SECRET_KEY is REQUIRED — the app refuses to start without a real value)
# -----------------------------------------------------------------------------
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
# Placeholders such as "change-this-secret" are rejected at startup by design.
SECRET_KEY=

JWT_ALGORITHM=HS256

# BOTH are in SECONDS. The old config commented REFRESH_TOKEN_EXPIRY as "days"
# while passing it to timedelta(seconds=...) — a value of 1 meant refresh tokens
# expired after one second.
ACCESS_TOKEN_EXPIRY=3600      # 1 hour
REFRESH_TOKEN_EXPIRY=86400    # 1 day


# -----------------------------------------------------------------------------
# Health-check loop
# -----------------------------------------------------------------------------
# Endpoints probed in parallel per cycle. Must stay below the HTTP client's
# max_connections (100) and the DB pool (30). Lower it if the monitored services
# are sensitive to bursts.
HEALTH_CHECK_CONCURRENCY=25

# Hard per-probe deadline, above httpx's own timeouts.
HEALTH_CHECK_TIMEOUT_S=20

# Response bodies larger than this are truncated before storage. health_check_logs
# grows ~720k rows/day at 500 endpoints — keep this small.
MAX_RESPONSE_BODY_BYTES=8192


# -----------------------------------------------------------------------------
# Login rate limiting  (Redis-backed; no effect if Redis is unavailable)
# -----------------------------------------------------------------------------
# The IP budget is deliberately generous: the integration suite performs ~11
# logins from one address. The per-email limit is the real brute-force gate.
LOGIN_RATE_LIMIT_IP_MAX=30
LOGIN_RATE_LIMIT_IP_WINDOW_S=300
LOGIN_RATE_LIMIT_EMAIL_MAX=5
LOGIN_RATE_LIMIT_EMAIL_WINDOW_S=900


# -----------------------------------------------------------------------------
# Email — Brevo SMTP  (optional; digests are skipped and logged if unset)
# -----------------------------------------------------------------------------
BREVO_SMTP_SERVER=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_PASSWORD=
SENDER_EMAIL=alerts@yourdomain.com


# -----------------------------------------------------------------------------
# Tests
# -----------------------------------------------------------------------------
# The suite is black-box HTTP against a running API. It creates real users and
# services and never cleans up — point it at a throwaway environment.
API_BASE_URL=http://localhost:8000


# -----------------------------------------------------------------------------
# Deliberately omitted
# -----------------------------------------------------------------------------
# These exist in app/core/config.py but nothing reads them. Setting them has no
# effect, so they are left out to avoid the impression that they do something:
#
#   KAFKA_BROKER     — the clients read KAFKA_BROKER_URL instead
#   NOTIFY_EMAIL     — never referenced
#   NOTIFY_WEBHOOK   — never referenced
#   SMTP_SERVER      — superseded by BREVO_SMTP_SERVER
#   Port / Login / Password — leftovers from an earlier SMTP config
